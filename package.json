{
  "name": "payload-sns-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently --kill-others --names api,web \"npm run dev -w @sns/backend\" \"npm run dev -w @sns/frontend\"",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "seed": "npm run seed -w @sns/backend",
    "migrate": "npm run migrate -w @sns/backend",
    "test:auth": "node --test tests/auth.test.mjs",
    "db:inspect": "node scripts/inspect-db.mjs",
    "test:posts": "node --test tests/posts.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

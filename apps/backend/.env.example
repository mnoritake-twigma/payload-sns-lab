PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=file:./data/sns.db
PAYLOAD_PUBLIC_URL=http://localhost:4310
# Local test users only. setup generates random values in the ignored .env file.
SEED_ADMIN_PASSWORD=replace-with-a-local-test-password
SEED_MEMBER_PASSWORD=replace-with-a-local-test-password

# Okta: OIDC Web Application, Authorization Code + PKCE, client_secret_basic.
# Register exactly: http://127.0.0.1:5173/api/oidc/callback
APP_URL=http://127.0.0.1:5173
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
